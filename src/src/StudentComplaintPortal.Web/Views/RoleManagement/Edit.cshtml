@model List<StudentComplaintPortal.Application.DTOs.PermissionDto>

@{
    ViewData["Title"] = "Edit Role";
    var roleId = ViewBag.RoleId as string;
    var roleName = ViewBag.RoleName as string;
}

<h3>@(roleId == null ? "Create Role" : $"Edit Role: {roleName}")</h3>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@roleId" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Role Name</label>
        <input type="text" name="Name" class="form-control" value="@roleName" required />
    </div>

    <h5>Permissions</h5>

    @foreach (var module in Model.GroupBy(p => p.Module))
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">@module.Key</div>
            <div class="card-body">
                @foreach (var perm in module)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="SelectedPermissionCodes" value="@perm.Code"
                               id="perm_@perm.Id" checked="@perm.IsGranted" />
                        <label class="form-check-label" for="perm_@perm.Id">
                            @perm.DisplayName
                        </label>
                    </div>
                }
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary">Save Role</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>