@{
    ViewData["Title"] = "Category Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Category Management</h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <ul class="nav nav-tabs mb-4" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="list-tab" data-bs-toggle="tab" href="#list" role="tab">All Categories</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="create-tab" data-bs-toggle="tab" href="#create" role="tab">Create New</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="edit-tab" data-bs-toggle="tab" href="#edit" role="tab" style="display:none;">Edit Category</a>
                </li>
            </ul>

            <div class="tab-content">
                <!-- List Tab -->
                <div class="tab-pane fade show active" id="list" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover bg-white">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Attachment Rules</th>
                                    <th>Staff Assigned</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="categoriesTable">
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Loading categories...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Create Tab -->
                <div class="tab-pane fade" id="create" role="tabpanel">
                    <div class="card shadow-sm p-4">
                        <h4 class="mb-4">Create New Category</h4>

                        <!-- Basic Category Info -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Name</label>
                            <input type="text" id="categoryName" class="form-control" placeholder="e.g., Admission Issues, Academic Concerns" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            <textarea id="categoryDescription" class="form-control" rows="3" placeholder="Describe what this category is for..."></textarea>
                        </div>

                        <!-- Icon Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Icon</label>
                            <div class="icon-selector">
                                <button type="button" class="icon-btn" onclick="selectIcon(this, '🎓')">🎓</button>
                                <button type="button" class="icon-btn" onclick="selectIcon(this, '💰')">💰</button>
                                <button type="button" class="icon-btn" onclick="selectIcon(this, '🏫')">🏫</button>
                                <button type="button" class="icon-btn" onclick="selectIcon(this, '🔒')">🔒</button>
                                <button type="button" class="icon-btn" onclick="selectIcon(this, '🏠')">🏠</button>
                                <button type="button" class="icon-btn active" onclick="selectIcon(this, '📋')">📋</button>
                                <button type="button" class="icon-btn" onclick="selectIcon(this, '❓')">❓</button>
                            </div>
                            <input type="hidden" id="categoryIcon" value="📋" />
                            <small class="text-muted">Selected: <span id="iconPreview">📋</span></small>
                        </div>

                        <!-- Color Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Color</label>
                            <div class="color-selector">
                                <input type="color" id="categoryColor" class="form-control form-control-color" value="#007bff" style="width: 100px; height: 40px;" />
                            </div>
                            <small class="text-muted">Pick a color for category badge</small>
                        </div>

                        <!-- Assignees -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Assign Staff Handlers</label>
                            <select id="categoryAssignees" class="form-select" multiple size="4">
                                <!-- Populated dynamically via JS -->
                            </select>
                            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple staff members.</small>
                        </div>

                        <!-- Dynamic Attachment Rules -->
                        <div class="mb-3">
                            <h5 class="fw-bold">Attachment Rules</h5>
                            <div id="rulesContainer"></div>
                            <button class="btn btn-outline-primary btn-sm mt-2" type="button" onclick="addRuleRow()">+ Add Attachment Rule</button>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-success" onclick="submitCategory()">Save Category</button>
                            <button class="btn btn-secondary" onclick="resetForm()">Clear</button>
                        </div>
                    </div>
                </div>

                <!-- Edit Tab -->
                <div class="tab-pane fade" id="edit" role="tabpanel">
                    <div class="card shadow-sm p-4">
                        <h4 class="mb-4">Edit Category</h4>

                        <input type="hidden" id="editCategoryId" />

                        <!-- Basic Category Info -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Name</label>
                            <input type="text" id="editCategoryName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            <textarea id="editCategoryDescription" class="form-control" rows="3"></textarea>
                        </div>

                        <!-- Icon Selection for Edit -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Icon</label>
                            <div class="edit-icon-selector">
                                <button type="button" class="edit-icon-btn" onclick="selectEditIcon(this, '🎓')">🎓</button>
                                <button type="button" class="edit-icon-btn" onclick="selectEditIcon(this, '💰')">💰</button>
                                <button type="button" class="edit-icon-btn" onclick="selectEditIcon(this, '🏫')">🏫</button>
                                <button type="button" class="edit-icon-btn" onclick="selectEditIcon(this, '🔒')">🔒</button>
                                <button type="button" class="edit-icon-btn" onclick="selectEditIcon(this, '🏠')">🏠</button>
                                <button type="button" class="edit-icon-btn active" onclick="selectEditIcon(this, '📋')">📋</button>
                                <button type="button" class="edit-icon-btn" onclick="selectEditIcon(this, '❓')">❓</button>
                            </div>
                            <input type="hidden" id="editCategoryIcon" value="📋" />
                            <small class="text-muted">Selected: <span id="editIconPreview">📋</span></small>
                        </div>

                        <!-- Color Selection for Edit -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Color</label>
                            <div class="color-selector">
                                <input type="color" id="editCategoryColor" class="form-control form-control-color" value="#007bff" style="width: 100px; height: 40px;" />
                            </div>
                            <small class="text-muted">Pick a color for category badge</small>
                        </div>

                        <!-- Assignees -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Assign Staff Handlers</label>
                            <select id="editCategoryAssignees" class="form-select" multiple size="4">
                                <!-- Populated dynamically via JS -->
                            </select>
                            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple staff members.</small>
                        </div>

                        <!-- Dynamic Attachment Rules -->
                        <div class="mb-3">
                            <h5 class="fw-bold">Attachment Rules</h5>
                            <div id="editRulesContainer"></div>
                            <button class="btn btn-outline-primary btn-sm mt-2" type="button" onclick="addEditRuleRow()">+ Add Attachment Rule</button>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-success" onclick="updateCategory()">Update Category</button>
                            <button class="btn btn-secondary" onclick="cancelEdit()">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let ruleIndex = 0;
        let editRuleIndex = 0;

        document.addEventListener("DOMContentLoaded", async () => {
            await loadCategories();
            await loadStaff();
            addRuleRow();
        });

        async function loadCategories() {
            try {
                const response = await fetch('/api/categories');
                if (response.ok) {
                    const categories = await response.json();
                    const tbody = document.getElementById('categoriesTable');
                    tbody.innerHTML = '';

                    if (categories.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No categories found</td></tr>';
                        return;
                    }

                    categories.forEach(cat => {
                        const row = document.createElement('tr');
                        const badgeColor = cat.color || '#007bff';
                        row.innerHTML = `
                            <td><span style="font-size: 20px; margin-right: 8px;">${cat.icon || '📋'}</span><strong>${escapeHtml(cat.name)}</strong></td>
                            <td>${escapeHtml(cat.description || 'N/A')}</td>
                            <td><span class="badge ${cat.isActive ? 'bg-success' : 'bg-secondary'}">${cat.isActive ? 'Active' : 'Inactive'}</span></td>
                            <td>${cat.attachmentRules ? cat.attachmentRules.length : 0}</td>
                            <td>${cat.assigneeIds ? cat.assigneeIds.length : 0}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning me-2" onclick="loadEditForm(${cat.id})">Edit</button>
                                <button class="btn btn-sm btn-outline-danger me-2" onclick="deleteCategory(${cat.id})">Delete</button>
                                <button class="btn btn-sm btn-outline-info" onclick="toggleCategory(${cat.id}, ${cat.isActive})">
                                    ${cat.isActive ? 'Deactivate' : 'Activate'}
                                </button>
                            </td>
                        `;
                        tbody.appendChild(row);
                    });
                } else {
                    document.getElementById('categoriesTable').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Failed to load categories</td></tr>';
                }
            } catch (error) {
                console.error('Error loading categories:', error);
                document.getElementById('categoriesTable').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error: ' + error.message + '</td></tr>';
            }
        }

        async function loadStaff() {
            try {
                const response = await fetch('/api/categories/staff');
                if (response.ok) {
                    const staff = await response.json();
                    const assigneeSelect = document.getElementById('categoryAssignees');
                    const editAssigneeSelect = document.getElementById('editCategoryAssignees');

                    assigneeSelect.innerHTML = '';
                    editAssigneeSelect.innerHTML = '';

                    staff.forEach(user => {
                        const option1 = document.createElement('option');
                        option1.value = user.id;
                        option1.textContent = user.fullName + ' (' + user.email + ')';
                        assigneeSelect.appendChild(option1);

                        const option2 = document.createElement('option');
                        option2.value = user.id;
                        option2.textContent = user.fullName + ' (' + user.email + ')';
                        editAssigneeSelect.appendChild(option2);
                    });
                }
            } catch (error) {
                console.error('Error loading staff:', error);
            }
        }

        function addRuleRow() {
            const container = document.getElementById('rulesContainer');
            const rowId = `rule-${ruleIndex}`;

            const html = `
                <div class="row g-2 mb-2 align-items-center rule-row" id="${rowId}">
                    <div class="col-md-3">
                        <select class="form-select rule-type">
                            <option value="Photo">Image/Photo</option>
                            <option value="Video">Video</option>
                            <option value="VoiceNote">Voice Note</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" class="form-control rule-count" placeholder="Max Count" min="1" value="1">
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control rule-size" placeholder="Max Size (MB)" min="1" value="5">
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-2">
                            <input class="form-check-input rule-required" type="checkbox" id="req-${ruleIndex}">
                            <label class="form-check-label" for="req-${ruleIndex}">Required</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-danger btn-sm" type="button" onclick="document.getElementById('${rowId}').remove()">Remove</button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            ruleIndex++;
        }

        function addEditRuleRow() {
            const container = document.getElementById('editRulesContainer');
            const rowId = `edit-rule-${editRuleIndex}`;

            const html = `
                <div class="row g-2 mb-2 align-items-center edit-rule-row" id="${rowId}">
                    <div class="col-md-3">
                        <select class="form-select edit-rule-type">
                            <option value="Photo">Image/Photo</option>
                            <option value="Video">Video</option>
                            <option value="VoiceNote">Voice Note</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" class="form-control edit-rule-count" placeholder="Max Count" min="1" value="1">
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control edit-rule-size" placeholder="Max Size (MB)" min="1" value="5">
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-2">
                            <input class="form-check-input edit-rule-required" type="checkbox" id="edit-req-${editRuleIndex}">
                            <label class="form-check-label" for="edit-req-${editRuleIndex}">Required</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-danger btn-sm" type="button" onclick="document.getElementById('${rowId}').remove()">Remove</button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            editRuleIndex++;
        }

        function selectIcon(button, icon) {
            document.querySelectorAll('.icon-selector .icon-btn').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
            document.getElementById('categoryIcon').value = icon;
            document.getElementById('iconPreview').textContent = icon;
        }

        function selectEditIcon(button, icon) {
            document.querySelectorAll('.edit-icon-selector .edit-icon-btn').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
            document.getElementById('editCategoryIcon').value = icon;
            document.getElementById('editIconPreview').textContent = icon;
        }

        async function loadEditForm(categoryId) {
            try {
                const response = await fetch(`/api/categories/${categoryId}`);
                if (response.ok) {
                    const category = await response.json();
                    document.getElementById('editCategoryId').value = category.id;
                    document.getElementById('editCategoryName').value = category.name;
                    document.getElementById('editCategoryDescription').value = category.description || '';

                    // Load icon and color
                    document.getElementById('editCategoryIcon').value = category.icon || '📋';
                    document.getElementById('editCategoryColor').value = category.color || '#007bff';
                    document.getElementById('editIconPreview').textContent = category.icon || '📋';

                    // Set active icon button
                    document.querySelectorAll('.edit-icon-selector .edit-icon-btn').forEach(btn => {
                        btn.classList.remove('active');
                        if (btn.textContent === (category.icon || '📋')) {
                            btn.classList.add('active');
                        }
                    });

                    // Load rules
                    const editRulesContainer = document.getElementById('editRulesContainer');
                    editRulesContainer.innerHTML = '';
                    editRuleIndex = 0;

                    if (category.attachmentRules && category.attachmentRules.length > 0) {
                        category.attachmentRules.forEach(rule => {
                            const container = editRulesContainer;
                            const rowId = `edit-rule-${editRuleIndex}`;
                            const sizeInMB = rule.maxFileSizeBytes / (1024 * 1024);

                            const html = `
                                <div class="row g-2 mb-2 align-items-center edit-rule-row" id="${rowId}">
                                    <div class="col-md-3">
                                        <select class="form-select edit-rule-type">
                                            <option value="Photo" ${rule.fileType === 'Photo' ? 'selected' : ''}>Image/Photo</option>
                                            <option value="Video" ${rule.fileType === 'Video' ? 'selected' : ''}>Video</option>
                                            <option value="VoiceNote" ${rule.fileType === 'VoiceNote' ? 'selected' : ''}>Voice Note</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <input type="number" class="form-control edit-rule-count" placeholder="Max Count" min="1" value="${rule.maxFileCount}">
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control edit-rule-size" placeholder="Max Size (MB)" min="1" value="${sizeInMB}">
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-check mt-2">
                                            <input class="form-check-input edit-rule-required" type="checkbox" id="edit-req-${editRuleIndex}" ${rule.isRequired ? 'checked' : ''}>
                                            <label class="form-check-label" for="edit-req-${editRuleIndex}">Required</label>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-danger btn-sm" type="button" onclick="document.getElementById('${rowId}').remove()">Remove</button>
                                    </div>
                                </div>
                            `;
                            container.insertAdjacentHTML('beforeend', html);
                            editRuleIndex++;
                        });
                    } else {
                        addEditRuleRow();
                    }

                    // Load assignees
                    const editAssigneeSelect = document.getElementById('editCategoryAssignees');
                    if (category.assigneeIds && category.assigneeIds.length > 0) {
                        Array.from(editAssigneeSelect.options).forEach(option => {
                            option.selected = category.assigneeIds.includes(option.value);
                        });
                    }

                    // Switch to edit tab
                    document.getElementById('edit-tab').style.display = 'block';
                    document.getElementById('edit-tab').click();
                } else {
                    alert("Failed to load category details");
                }
            } catch (error) {
                console.error('Error loading category:', error);
                alert("Error: " + error.message);
            }
        }

        async function submitCategory() {
            const name = document.getElementById('categoryName').value;
            const description = document.getElementById('categoryDescription').value;
            const icon = document.getElementById('categoryIcon').value;
            const color = document.getElementById('categoryColor').value;

            if (!name) {
                alert("Category Name is required!");
                return;
            }

            const assigneeSelect = document.getElementById('categoryAssignees');
            const assigneeIds = Array.from(assigneeSelect.selectedOptions).map(opt => opt.value);

            const attachmentRules = [];
            document.querySelectorAll('#rulesContainer .rule-row').forEach(row => {
                attachmentRules.push({
                    fileType: row.querySelector('.rule-type').value,
                    maxFileCount: parseInt(row.querySelector('.rule-count').value),
                    maxFileSizeBytes: parseInt(row.querySelector('.rule-size').value) * 1024 * 1024,
                    isRequired: row.querySelector('.rule-required').checked
                });
            });

            const payload = { name, description, icon, color, assigneeIds, attachmentRules };

            try {
                const response = await fetch('/api/categories', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert("Category successfully created!");
                    resetForm();
                    await loadCategories();
                    document.getElementById('list-tab').click();
                } else {
                    const error = await response.json();
                    alert("Failed to create category: " + JSON.stringify(error));
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred while saving.");
            }
        }

        async function updateCategory() {
            const categoryId = document.getElementById('editCategoryId').value;
            const name = document.getElementById('editCategoryName').value;
            const description = document.getElementById('editCategoryDescription').value;
            const icon = document.getElementById('editCategoryIcon').value;
            const color = document.getElementById('editCategoryColor').value;

            if (!name) {
                alert("Category Name is required!");
                return;
            }

            const assigneeSelect = document.getElementById('editCategoryAssignees');
            const assigneeIds = Array.from(assigneeSelect.selectedOptions).map(opt => opt.value);

            const attachmentRules = [];
            document.querySelectorAll('#editRulesContainer .edit-rule-row').forEach(row => {
                attachmentRules.push({
                    fileType: row.querySelector('.edit-rule-type').value,
                    maxFileCount: parseInt(row.querySelector('.edit-rule-count').value),
                    maxFileSizeBytes: parseInt(row.querySelector('.edit-rule-size').value) * 1024 * 1024,
                    isRequired: row.querySelector('.edit-rule-required').checked
                });
            });

            const payload = { name, description, icon, color, assigneeIds, attachmentRules };

            try {
                const response = await fetch(`/api/categories/${categoryId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert("Category successfully updated!");
                    await loadCategories();
                    cancelEdit();
                } else {
                    const error = await response.json();
                    alert("Failed to update category: " + JSON.stringify(error));
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred while updating.");
            }
        }

        async function deleteCategory(id) {
            if (!confirm("Are you sure you want to delete this category? This action cannot be undone.")) {
                return;
            }

            try {
                const response = await fetch(`/api/categories/${id}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok) {
                    alert("Category deleted successfully!");
                    await loadCategories();
                } else {
                    alert("Failed to delete category");
                }
            } catch (error) {
                console.error('Error deleting category:', error);
                alert("Error: " + error.message);
            }
        }

        async function toggleCategory(id, isActive) {
            if (!confirm(`Are you sure you want to ${isActive ? 'deactivate' : 'activate'} this category?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/categories/${id}/toggle-active`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok) {
                    await loadCategories();
                } else {
                    alert("Failed to toggle category status");
                }
            } catch (error) {
                console.error('Error toggling category:', error);
                alert("Error: " + error.message);
            }
        }

        function cancelEdit() {
            document.getElementById('edit-tab').style.display = 'none';
            document.getElementById('list-tab').click();
        }

        function resetForm() {
            document.getElementById('categoryName').value = '';
            document.getElementById('categoryDescription').value = '';
            document.getElementById('categoryAssignees').value = '';
            document.getElementById('rulesContainer').innerHTML = '';
            ruleIndex = 0;
            addRuleRow();
        }

        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }
    </script>
}
