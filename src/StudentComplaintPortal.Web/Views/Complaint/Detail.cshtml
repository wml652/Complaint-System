@model StudentComplaintPortal.Application.DTOs.ComplaintDto
@{
    ViewData["Title"] = "Complaint Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@Model.Title</h4>
                <span class="badge @(Model.Status == "Open" ? "bg-success" : Model.Status == "InProgress" ? "bg-warning text-dark" : "bg-secondary")">@Model.Status</span>
            </div>
            <div class="card-body">
                <p><strong>Category:</strong> <span class="badge bg-secondary">@Model.Category</span></p>
                <p><strong>Description:</strong></p>
                <p>@Model.Description</p>
                <p><strong>Submitted by:</strong> @Model.StudentName</p>
                <p class="text-muted small">
                    <strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")<br />
                    <strong>Last Updated:</strong> @Model.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")
                </p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <hr />
                    <div class="d-flex align-items-center">
                        <label class="me-2 mb-0"><strong>Update Status:</strong></label>
                        <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="newStatus" class="form-select me-2" style="width: auto;">
                                @foreach (var status in Enum.GetValues<StudentComplaintPortal.Domain.Enums.ComplaintStatus>())
                                {
                                    <option value="@status" selected="@(Model.Status == status.ToString())">@status</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Update</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Conversation</h5>
            </div>
            <div class="card-body p-0">
                <component type="typeof(StudentComplaintPortal.Web.Components.ComplaintChat)"
                           render-mode="ServerPrerendered"
                           param-ComplaintId="@Model.Id" />
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Quick Actions</h6>
            </div>
            <div class="card-body">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary w-100 mb-2">Back to Dashboard</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/audioRecorder.js" asp-append-version="true"></script>
}
