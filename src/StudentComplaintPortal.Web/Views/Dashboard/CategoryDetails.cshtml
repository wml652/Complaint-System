@model CategoryDto

@{
    ViewData["Title"] = "Category Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>@Model.Name</h2>
                    <p class="text-muted">Category ID: @Model.Id</p>
                </div>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Inactive</span>
                    }
                </div>
            </div>

            <!-- Description -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Description</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted">No description provided.</p>
                    }
                </div>
            </div>

            <!-- Statistics Section -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="card-title">Total Complaints</h6>
                            <h3 id="totalComplaints" class="text-primary">-</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="card-title">Open Complaints</h6>
                            <h3 id="openComplaints" class="text-warning">-</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="card-title">Resolved Complaints</h6>
                            <h3 id="resolvedComplaints" class="text-success">-</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Assigned Staff Section -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Assigned Staff Members</h5>
                </div>
                <div class="card-body">
                    @if (Model.AssigneeIds.Count > 0)
                    {
                        <div id="staffList">
                            <!-- Will be populated by JavaScript -->
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No staff members assigned to this category.</p>
                    }
                </div>
            </div>

            <!-- Attachment Rules Section -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Attachment Rules</h5>
                </div>
                <div class="card-body">
                    @if (Model.AttachmentRules.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>File Type</th>
                                        <th>Max Count</th>
                                        <th>Max Size</th>
                                        <th>Required</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rule in Model.AttachmentRules)
                                    {
                                        <tr>
                                            <td>@rule.FileType</td>
                                            <td>@rule.MaxFileCount</td>
                                            <td>@FormatBytes(rule.MaxFileSizeBytes)</td>
                                            <td>
                                                @if (rule.IsRequired)
                                                {
                                                    <i class="bi bi-check-circle text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle text-danger"></i>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No attachment rules defined for this category.</p>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mb-4">
                <a href="@Url.Action("EditCategory", "Dashboard", new { id = Model.Id })" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit Category
                </a>
                <a href="@Url.Action("Categories", "Dashboard")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Categories
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const categoryId = @Model.Id;

        try {
            // Fetch category stats
            const response = await fetch(`/api/categories/${categoryId}/stats`);
            if (response.ok) {
                const stats = await response.json();
                document.getElementById('totalComplaints').textContent = stats.totalComplaints;
                document.getElementById('openComplaints').textContent = stats.openComplaints;
                document.getElementById('resolvedComplaints').textContent = stats.resolvedComplaints;

                // Populate staff list
                if (stats.assignedStaff && stats.assignedStaff.length > 0) {
                    const staffList = document.getElementById('staffList');
                    staffList.innerHTML = '';

                    const listGroup = document.createElement('div');
                    listGroup.className = 'list-group';

                    stats.assignedStaff.forEach(staff => {
                        const item = document.createElement('div');
                        item.className = 'list-group-item';
                        item.innerHTML = `
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@Html.Raw("${staff.fullName}")</h6>
                            </div>
                            <p class="mb-1 text-muted">@Html.Raw("${staff.email}")</p>
                        `;
                        listGroup.appendChild(item);
                    });

                    staffList.innerHTML = '';
                    staffList.appendChild(listGroup);
                }
            }
        } catch (error) {
            console.error('Error loading stats:', error);
        }
    });

    function formatBytes(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
    }
</script>
}

@functions {
    private string FormatBytes(long bytes)
    {
        if (bytes == 0) return "0 Bytes";
        const long k = 1024;
        string[] sizes = { "Bytes", "KB", "MB", "GB" };
        int i = (int)Math.Floor(Math.Log(bytes) / Math.Log(k));
        return Math.Round((double)bytes / Math.Pow(k, i), 2) + " " + sizes[i];
    }
}
