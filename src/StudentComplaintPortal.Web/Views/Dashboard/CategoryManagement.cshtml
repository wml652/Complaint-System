@{
    ViewData["Title"] = "Category Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Create New Complaint Category</h2>
    <hr />

    <div class="card shadow-sm p-4">
        <!-- Basic Category Info -->
        <div class="mb-3">
            <label class="form-label fw-bold">Category Name</label>
            <input type="text" id="categoryName" class="form-control" placeholder="e.g., Admission Cancel, Subject Change" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Description</label>
            <textarea id="categoryDescription" class="form-control" rows="2"></textarea>
        </div>

        <!-- Assignees -->
        <div class="mb-4">
            <label class="form-label fw-bold">Assign Staff Handlers</label>
            <select id="categoryAssignees" class="form-select" multiple size="4">
                <!-- Populated dynamically via JS -->
            </select>
            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple staff members.</small>
        </div>

        <!-- Dynamic Attachment Rules -->
        <div class="mb-3">
            <h5 class="fw-bold">Attachment Rules</h5>
            <div id="rulesContainer"></div>
            <button class="btn btn-outline-primary btn-sm mt-2" onclick="addRuleRow()">+ Add Attachment Rule</button>
        </div>

        <button class="btn btn-success mt-3" onclick="submitCategory()">Save Category</button>
    </div>
</div>

@section Scripts {
<script>
    let ruleIndex = 0;

    document.addEventListener("DOMContentLoaded", async () => {
        try {
            const response = await fetch('/api/categories/staff');
            const staff = await response.json();
            const assigneeSelect = document.getElementById('categoryAssignees');

            staff.forEach(user => {
                const option = document.createElement('option');
                option.value = user.id;
                option.textContent = user.fullName;
                assigneeSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error fetching staff:', error);
        }

        addRuleRow();
    });

    function addRuleRow() {
        const container = document.getElementById('rulesContainer');
        const rowId = `rule-${ruleIndex}`;

        const html = `
            <div class="row g-2 mb-2 align-items-center rule-row" id="${rowId}">
                <div class="col-md-3">
                    <select class="form-select rule-type">
                        <option value="Photo">Image/Photo</option>
                        <option value="Video">Video</option>
                        <option value="VoiceNote">Voice Note</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control rule-count" placeholder="Max Count" min="1" value="1">
                </div>
                <div class="col-md-3">
                    <input type="number" class="form-control rule-size" placeholder="Max Size (MB)" min="1" value="5">
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-2">
                        <input class="form-check-input rule-required" type="checkbox" id="req-${ruleIndex}">
                        <label class="form-check-label" for="req-${ruleIndex}">Required</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-danger btn-sm" onclick="document.getElementById('${rowId}').remove()">Remove</button>
                </div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
        ruleIndex++;
    }

    async function submitCategory() {
        const name = document.getElementById('categoryName').value;
        const description = document.getElementById('categoryDescription').value;

        if (!name) {
            alert("Category Name is required!");
            return;
        }

        const assigneeSelect = document.getElementById('categoryAssignees');
        const assigneeIds = Array.from(assigneeSelect.selectedOptions).map(opt => opt.value);

        const attachmentRules = [];
        document.querySelectorAll('.rule-row').forEach(row => {
            attachmentRules.push({
                fileType: row.querySelector('.rule-type').value,
                maxFileCount: parseInt(row.querySelector('.rule-count').value),
                maxFileSizeBytes: parseInt(row.querySelector('.rule-size').value) * 1024 * 1024,
                isRequired: row.querySelector('.rule-required').checked
            });
        });

        const payload = { name, description, assigneeIds, attachmentRules };

        try {
            const response = await fetch('/api/categories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                alert("Category successfully created!");
                window.location.reload();
            } else {
                const error = await response.json();
                alert("Failed to create category: " + JSON.stringify(error));
            }
        } catch (err) {
            console.error(err);
            alert("An error occurred while saving.");
        }
    }
</script>
}
