@using Microsoft.AspNetCore.SignalR.Client
@using StudentComplaintPortal.Application.DTOs
@using StudentComplaintPortal.Application.Services
@using StudentComplaintPortal.Domain.Enums
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IMessageService MessageService
@inject IAttachmentService AttachmentService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable
@inject MessageBufferService BufferService

<div class="chat-container">
    <div class="messages-area" id="messagesArea" style="height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 15px; margin-bottom: 15px; background-color: #f9f9f9;">
        @if (messages == null)
        {
            <p class="text-center text-muted">Loading conversation...</p>
        }
        else if (!messages.Any())
        {
            <p class="text-center text-muted">No messages yet. Start the conversation!</p>
        }
        else
        {
            @foreach (var msg in messages)
            {
                <div class="message mb-3 @(msg.SenderId == userId ? "text-end" : "text-start")">
                    <div class="d-inline-block" style="max-width: 70%;">
                        <div class="@(msg.SenderId == userId ? "bg-primary text-white" : "bg-light") p-2 rounded">
                            <strong>@msg.SenderName</strong>
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="mb-1">@msg.Content</p>
                            }
                            @if (msg.Attachments.Any())
                            {
                                <div class="attachments mt-2">
                                    @foreach (var attachment in msg.Attachments)
                                    {
                                        @if (attachment.FileType == "Photo")
                                        {
                                            <img src="@attachment.FileUrl" alt="Photo" class="img-fluid rounded mb-1" style="max-width: 300px;" />
                                        }
                                        else if (attachment.FileType == "Video")
                                        {
                                            <video controls class="w-100 rounded mb-1" style="max-width: 300px;">
                                                <source src="@attachment.FileUrl" type="video/mp4" />
                                                Your browser does not support the video tag.
                                            </video>
                                        }
                                        else if (attachment.FileType == "VoiceNote")
                                        {
                                            <audio controls class="w-100 mb-1">
                                                <source src="@attachment.FileUrl" type="audio/webm" />
                                                <source src="@attachment.FileUrl" type="audio/wav" />
                                                Your browser does not support the audio element.
                                            </audio>
                                        }
                                    }
                                </div>
                            }
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">@msg.SentAt.ToString("hh:mm tt")</small>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(uploadStatus))
    {
        <div class="alert alert-info">@uploadStatus</div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="input-area">
        @if (IsClosed)
        {
            <div class="alert alert-warning mb-0 d-flex align-items-center gap-2">
                <span>🔒</span>
                <span>This complaint is closed. The conversation is read-only.</span>
            </div>
        }
        else
        {
            <div class="mb-2">
                <textarea @bind="currentMessage" @bind:event="oninput" class="form-control" rows="2" placeholder="Type your message..." disabled="@isUploading"></textarea>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" @onclick="SendTextMessage" @onclick:preventDefault="true" disabled="@(isUploading || string.IsNullOrWhiteSpace(currentMessage))">Send</button>
                <InputFile OnChange="OnPhotoSelected" accept="image/*" id="photoInput" style="display:none;" disabled="@isUploading" />
                <label for="photoInput" class="btn btn-secondary @(isUploading ? "disabled" : "")">
                    📷 Photo
                </label>
                <InputFile OnChange="OnVideoSelected" accept="video/*" id="videoInput" style="display:none;" disabled="@isUploading" />
                <label for="videoInput" class="btn btn-secondary @(isUploading ? "disabled" : "")">
                    🎥 Video
                </label>
                <button type="button" class="btn btn-secondary" @onclick="ToggleRecording" @onclick:preventDefault="true" disabled="@isUploading">
                    @if (isRecording)
                    {
                        <span>⏹ Stop</span>
                    }
                    else
                    {
                        <span>🎤 Voice</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int ComplaintId { get; set; }

    [Parameter]
    public string? ComplaintStatus { get; set; }

    private bool IsClosed => ComplaintStatus == "Closed";

    private List<MessageDto> messages = new();
    private string currentMessage = string.Empty;
    private string? userId;
    private string? uploadStatus;
    private string? errorMessage;
    private bool isUploading = false;
    private bool isRecording = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "You must be logged in to view this chat.";
                return;
            }

            // 1. SUBSCRIBE TO THE SINGLETON EVENT
            BufferService.OnMessageBroadcast += HandleNewMessage;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to get authentication state: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // 2. Load the initial chat history (DB + Buffer)
                var messageList = await MessageService.GetConversationAsync(ComplaintId);
                messages = messageList.ToList();
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to load messages: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // 3. THE EVENT HANDLER THAT INSTANTLY UPDATES THE SCREEN
    private async void HandleNewMessage(int complaintId, MessageDto message)
    {
        // Only update if it belongs to this chat room AND came from the OTHER person
        if (complaintId == ComplaintId && message.SenderId != userId)
        {
            // InvokeAsync is required for thread-safety in Blazor Server
            await InvokeAsync(async () =>
            {
                messages.Add(message);
                StateHasChanged();
                await ScrollToBottom();
            });
        }
    }

    private async Task SendTextMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage)) return;

        var messageToSend = currentMessage;
        currentMessage = string.Empty;

        try
        {
            var messageDto = await MessageService.SendMessageAsync(ComplaintId, userId!, messageToSend, null);

            // Add to our own screen
            messages.Add(messageDto);

            // 4. INSTANTLY NOTIFY THE OTHER PERSON VIA C# EVENT
            BufferService.BroadcastToClients(ComplaintId, messageDto);

            errorMessage = null;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to send message: {ex.Message}";
            currentMessage = messageToSend;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0) await UploadFile(e.File, "Photo");
    }

    private async Task OnVideoSelected(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0) await UploadFile(e.File, "Video");
    }

    private async Task UploadFile(IBrowserFile file, string fileType)
    {
        isUploading = true;
        uploadStatus = $"Uploading {fileType.ToLower()}...";
        errorMessage = null;
        StateHasChanged();

        try
        {
            if (!Enum.TryParse<FileType>(fileType, true, out var parsedFileType))
            {
                errorMessage = $"Invalid file type: {fileType}";
                return;
            }

            using var fileStream = file.OpenReadStream(maxAllowedSize: 52428800);
            var messageDto = await AttachmentService.CreateMessageWithAttachmentAsync(
                ComplaintId, userId!, fileStream, file.Name, file.ContentType, parsedFileType, null);

            messages.Add(messageDto);

            // NOTIFY THE OTHER PERSON VIA EVENT
            BufferService.BroadcastToClients(ComplaintId, messageDto);

            uploadStatus = null;
            errorMessage = null;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            errorMessage = $"Upload error: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isUploading = false;
            uploadStatus = null;
            StateHasChanged();
        }
    }

    private async Task ToggleRecording()
    {
        if (isRecording) await StopRecording();
        else await StartRecording();
    }

    private async Task StartRecording()
    {
        try
        {
            await JS.InvokeVoidAsync("audioRecorder.start");
            isRecording = true;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to start recording: {ex.Message}";
        }
    }

    private async Task StopRecording()
    {
        try
        {
            isRecording = false;
            isUploading = true;
            uploadStatus = "Processing voice note...";
            StateHasChanged();

            var audioData = await JS.InvokeAsync<byte[]>("audioRecorder.stop");

            using var memoryStream = new MemoryStream(audioData);
            var fileName = $"voice-{DateTime.UtcNow.Ticks}.webm";
            var messageDto = await AttachmentService.CreateMessageWithAttachmentAsync(
                ComplaintId, userId!, memoryStream, fileName, "audio/webm", FileType.VoiceNote, null);

            messages.Add(messageDto);

            // NOTIFY THE OTHER PERSON VIA EVENT
            BufferService.BroadcastToClients(ComplaintId, messageDto);

            uploadStatus = null;
            errorMessage = null;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            errorMessage = $"Recording error: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isUploading = false;
            uploadStatus = null;
            StateHasChanged();
        }
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", "messagesArea"); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        // 5. UNSUBSCRIBE TO PREVENT MEMORY LEAKS
        BufferService.OnMessageBroadcast -= HandleNewMessage;
    }
}